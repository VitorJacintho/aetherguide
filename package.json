{
  "name": "aetherguide",
  "productName": "Aetherguide",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Companheiro para iniciantes de Final Fantasy XIV — começando pelo Black Mage.",
  "author": "VitorJacintho",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:xivapi": "node --experimental-strip-types --no-warnings scripts/fetch-xivapi.ts",
    "app:dev": "node scripts/dev-app.mjs",
    "app": "npm run build && electron .",
    "app:selftest": "npm run build && electron . --selftest",
    "dist:win": "npm run build && electron-builder --win",
    "fake-act": "node --experimental-strip-types --no-warnings scripts/fake-act.ts",
    "rec:info": "node scripts/rec-info.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "ws": "^8.22.1"
  },
  "build": {
    "appId": "io.github.vitorjacintho.aetherguide",
    "productName": "Aetherguide",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Aetherguide",
      "artifactName": "Aetherguide-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "Aetherguide-${version}-portatil.${ext}"
    }
  }
}
